# ==============================================================================
# MRTG Traffic Monitor - Environment Configuration (.env)
# Copy this file to '.env' in the project root and configure your values.
# ==============================================================================

# Application branding and site identification
APP_NAME="MRTG Traffic Monitor"
SITE_NAME="Enterprise Gateway"
LOCATION_NAME="Branch Office"
UPLINK_NAME="Main Uplink (150 Mbps)"

# SQLite database file path (automatically created if not present)
DATABASE_PATH="data/traffic.db"

# ------------------------------------------------------------------------------
# MIKROTIK ROUTEROS API CONNECTION
# ------------------------------------------------------------------------------
# RouterOS IP or tunnel domain (e.g. 192.168.88.1 or your tunnel host)
ROUTEROS_HOST="192.168.88.1"

# Remote/local port forwarded to RouterOS API (8728)
ROUTEROS_PORT=8728

# RouterOS username (requires 'read' group for monitoring)
ROUTEROS_USERNAME="mrtg"

# RouterOS user password
ROUTEROS_PASSWORD=""

# Monitored network interface name (e.g. WAN or ether1)
ROUTEROS_INTERFACE="WAN"

# ------------------------------------------------------------------------------
# DATA COLLECTION INTERVAL (COLLECTOR DAEMON)
# ------------------------------------------------------------------------------
# Polling interval in seconds (default: 60 seconds = 1 minute)
POLLING_INTERVAL=60

# ------------------------------------------------------------------------------
# WEB DASHBOARD (FASTAPI & UVICORN)
# ------------------------------------------------------------------------------
# Web server network bind address (0.0.0.0 to listen on all interfaces)
WEB_HOST="0.0.0.0"

# Web dashboard TCP port (default: 8000)
WEB_PORT=8000

# Secret key for cookie session encryption
SECRET_KEY="change-this-secret-key-in-production"

# Set true if deployed behind HTTPS/SSL, false for plain HTTP
SESSION_COOKIE_SECURE=false

# Standard web session lifetime in seconds (default: 28800 = 8 hours)
SESSION_TTL_SECONDS=28800

# Extended session lifetime when "Remember Me" is checked (default: 2592000 = 30 days)
REMEMBER_ME_TTL_SECONDS=2592000

# ------------------------------------------------------------------------------
# INITIAL WEB DASHBOARD ADMINISTRATOR
# ------------------------------------------------------------------------------
# Administrator username seeded upon 'mrtg-poncab init-db'
ADMIN_USERNAME="admin"

# Administrator password (if left empty, defaults to 'admin123')
ADMIN_PASSWORD=""

# ------------------------------------------------------------------------------
# TUNNEL.WEB.ID WATCHDOG & AUTO-HEALING (OPTIONAL)
# ------------------------------------------------------------------------------
# Credentials for member.tunnel.web.id for automated status inspection and restart
TUNNEL_WEB_EMAIL=""
TUNNEL_WEB_PASSWORD=""
TUNNEL_WEB_SERVICE_ID=""
TUNNEL_AUTO_RESTART=false
TUNNEL_RESTART_COOLDOWN_MINUTES=30

# ------------------------------------------------------------------------------
# WHATSAPP NOTIFICATION ALERTS (GOWA REST GATEWAY)
# ------------------------------------------------------------------------------
# Enable automated WhatsApp alerts when router/tunnel disconnects or recovers
WA_ALERT_ENABLED=false

# Local GOWA gateway address (default on Debian: http://localhost:3000)
WA_GATEWAY_URL="http://localhost:3000"

# GOWA paired Device ID (e.g. NOC-Bot)
WA_DEVICE_ID=""

# Destination WhatsApp JID (phone number '628xxx@s.whatsapp.net' or group 'xxx@g.us')
WA_TARGET_JID=""

# Consecutive polling failure cycles before triggering DOWN alert (default: 2 cycles = ~60s)
WA_FAIL_THRESHOLD=2
