# ==============================================================================
# MRTG-Poncab - File Konfigurasi Lingkungan (.env)
# Salin file ini menjadi '.env' di folder yang sama dan sesuaikan nilainya.
# ==============================================================================

# Nama aplikasi yang ditampilkan di browser
APP_NAME="MRTG-Poncab"

# Lokasi file database SQLite (otomatis dibuat jika belum ada)
DATABASE_PATH="data/traffic.db"

# ------------------------------------------------------------------------------
# KONEKSI ROUTEROS API (MIKROTIK)
# ------------------------------------------------------------------------------
# Host/domain tunnel atau IP router MikroTik (contoh: 192.168.88.1 atau domain tunnel)
ROUTEROS_HOST="192.168.88.1"

# Port remote/lokal yang diarahkan ke port API (8728) MikroTik
ROUTEROS_PORT=8728

# Username MikroTik (grup 'read' khusus monitoring MRTG)
ROUTEROS_USERNAME="mrtg"

# Password user MikroTik di atas
ROUTEROS_PASSWORD=""

# Nama interface internet yang ingin dimonitor trafiknya (contoh: WAN atau ether1)
ROUTEROS_INTERFACE="WAN"

# ------------------------------------------------------------------------------
# INTERVAL PENGAMBILAN DATA (COLLECTOR)
# ------------------------------------------------------------------------------
# Interval pengambilan data trafik dalam satuan detik (default: 60 detik = 1 menit)
POLLING_INTERVAL=60

# ------------------------------------------------------------------------------
# WEB DASHBOARD (FASTAPI & UVICORN)
# ------------------------------------------------------------------------------
# Alamat IP binding server web (0.0.0.0 agar bisa diakses dari komputer lain di LAN)
WEB_HOST="0.0.0.0"

# Port web dashboard (contoh: 8000)
WEB_PORT=8000

# Kunci rahasia untuk sesi enkripsi cookie (acak bebas)
SECRET_KEY="gmf-mrtg-poncab-secret-key-change-in-production"

# Set true jika menggunakan HTTPS, false jika HTTP biasa
SESSION_COOKIE_SECURE=false

# Durasi sesi login normal dalam detik (default: 28800 = 8 jam)
SESSION_TTL_SECONDS=28800

# Durasi sesi jika centang "Remember Me" dalam detik (default: 2592000 = 30 hari)
REMEMBER_ME_TTL_SECONDS=2592000

# ------------------------------------------------------------------------------
# AKUN AWAL ADMINISTRATOR DASHBOARD
# ------------------------------------------------------------------------------
# Username administrator default saat 'mrtg-poncab init-db' dijalankan
ADMIN_USERNAME="admin"

# Password administrator default (jika dikosongkan, defaultnya: admin123)
ADMIN_PASSWORD=""
